{
  "name": "plessas-lab",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "Lab marketplace: mail-pro (second-brain email comms), Apple Notes (macOS only), Gmail, Nano Banana, YouTube, and chat-watch (Teams monitor with LLM gate)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "bash scripts/typecheck.sh"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": ">=8.0.16",
    "postcss": ">=8.5.23",
    "nanoid": ">=5.1.6"
  }
}
